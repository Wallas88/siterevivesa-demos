{
  "name": "copperkloof-plumbing-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "code-check": "node ../_core/checks/code/code-check.ts src shared scripts tests",
    "check": "npm run format:check && npm run lint && npm run code-check && npm test && npm run build",
    "ux-check": "node scripts/ux-check.ts",
    "flow-check": "node scripts/flow-check.ts",
    "sandbox-check": "node scripts/sandbox-check.ts",
    "verify": "npm run check && npm run ux-check && npm run flow-check && npm run sandbox-check",
    "deploy": "node ../_core/checks/deploy/deploy-guard.ts && npm ci && npm run check && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "rolldown": "1.2.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.131.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
